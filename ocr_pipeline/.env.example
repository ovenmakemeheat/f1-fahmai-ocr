# OCR Pipeline — Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า

# ─── vLLM server (GPU node) ────────────────────────────────
VLLM_BASE_URL=http://GPU_NODE_IP:8000/v1
VLLM_MODEL_NAME=scb10x/typhoon-ocr-7b


# ─── FastAPI ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4

# ─── Dataset (สำหรับ lookup visible_fields) ────────────────
PER_ARTIFACT_DIR=/data/fahmai/per_artifact
