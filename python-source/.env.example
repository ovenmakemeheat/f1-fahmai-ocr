# Vertex AI Gemini configuration for google-genai enterprise mode.

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_GENAI_AUTH=adc

# Optional non-Vertex API-key auth path.
# Do not put ya29 OAuth tokens here; use GOOGLE_OAUTH_ACCESS_TOKEN.
GEMINI_API_KEY=

# Optional short-lived Vertex bearer token.
# Only used when GOOGLE_GENAI_AUTH=token.
# This is an OAuth access token from:
#   gcloud auth application-default print-access-token
GOOGLE_OAUTH_ACCESS_TOKEN=

# Optional service account JSON path. Leave blank when using:
#   gcloud auth application-default login
GOOGLE_APPLICATION_CREDENTIALS=

# OCR pipeline settings
OCR_OUTPUT_DIR=work/ocr
OCR_MAX_RETRIES=3
OCR_WORKERS=16
GEMINI_TIMEOUT_SECONDS=120
